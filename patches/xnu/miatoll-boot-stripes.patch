diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index bca4c7c..25099a9 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -351,6 +351,32 @@ start_cpu:
 
 	b		common_start
 
+/*
+ * miatoll boot stripes. This phone has no serial port, so a stripe on the panel is the only
+ * record of how far the kernel got before its console exists. Band $0 below DarwinBoot's green
+ * bar, colour $2$1 (0xAARRGGBB), MMU off, x20 = boot args PA. Clobbers x1-x5.
+ */
+.macro MIATOLL_BAR
+	ldr		x1, [x20, #0x28]					// Video.v_baseAddr
+	ldr		x2, [x20, #0x38]					// Video.v_rowBytes
+	ldr		x3, [x20, #0x48]					// Video.v_height
+	lsr		x4, x3, #4
+	mul		x4, x4, x2
+	lsr		x5, x3, #5
+	mul		x5, x5, x2
+	mov		x3, #($0)
+	mul		x3, x3, x5
+	add		x1, x1, x4
+	add		x1, x1, x3
+	movz	w2, #($1)
+	movk	w2, #($2), lsl #16
+1:
+	stp		w2, w2, [x1], #8
+	subs	x5, x5, #8
+	b.hi	1b
+	dsb		sy
+.endmacro
+
 /*
  * create_l1_table_entry
  *
@@ -471,6 +497,8 @@ LEXT(start_first_cpu)
 	mov		x20, x0
 	mov		x21, #0
 
+	MIATOLL_BAR 0, 0x00FF, 0xFF00				// blue: kernel entry
+
 	// Set low reset vector before attempting any loads
 	adrp	x0, EXT(LowExceptionVectorBase)@page
 	add		x0, x0, EXT(LowExceptionVectorBase)@pageoff
@@ -623,6 +651,13 @@ Lbootstrap_tables_exhausted:
 	// the early debugger rather than corrupting memory or forging a map.
 	b Lbootstrap_tables_exhausted
 Lbootstrap_tables_ready:
+	/* Alias the frame buffer in TTBR0 for the C stripes, in an L1 slot of its own. */
+	ldr		x15, [x20, #0x28]
+	and		x15, x15, #0xffffffffffe00000
+	mov		x14, #0x2000000000
+	mov		x5, #7
+	create_bootstrap_mapping x14, x15, x5, x1, x2, x9, x10, x11, x12, x13
+
 	/* Ensure TTEs are visible */
 	dsb		ish
 
@@ -761,6 +796,9 @@ common_start:
 	PAC_INIT_KEY_STATE tmp=x0, tmp2=x1
 #endif /* HAS_APPLE_PAC */
 
+	cbnz	x21, 2f
+	MIATOLL_BAR 1, 0x00FF, 0xFFFF				// magenta: about to enable the MMU
+2:
 	// Enable caches, MMU, ROP and JOP
 	MOV64   x0, SCTLR_EL1_DEFAULT
 	MSR_SCTLR_EL1_X0
