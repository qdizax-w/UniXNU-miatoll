diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 7187c15..3de4bcd 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -343,6 +343,53 @@ arm_setup_pre_sign(void)
  */
 
 __startup_func
+/* miatoll boot stripes, see MIATOLL_BAR in start.s. Reaches the panel through the TTBR0 alias. */
+#define MIATOLL_PROBE_VA 0x2000000000ULL
+void miatoll_probe_start(boot_args *);
+void miatoll_probe_bar(unsigned int, uint32_t);
+void miatoll_probe_off(void);
+void miatoll_probe_panic(void);
+static uintptr_t miatoll_probe_fb;
+static uint64_t miatoll_probe_row, miatoll_probe_height;
+
+void
+miatoll_probe_start(boot_args *a)
+{
+	miatoll_probe_row = a->Video.v_rowBytes;
+	miatoll_probe_height = a->Video.v_height;
+	miatoll_probe_fb = (uintptr_t)MIATOLL_PROBE_VA + (a->Video.v_baseAddr & 0x1FFFFFULL);
+}
+
+void
+miatoll_probe_bar(unsigned int band, uint32_t color)
+{
+	if (miatoll_probe_fb == 0) {
+		return;
+	}
+	uint64_t top = miatoll_probe_row * (miatoll_probe_height >> 4);
+	uint64_t size = miatoll_probe_row * (miatoll_probe_height >> 5);
+	uintptr_t p = miatoll_probe_fb + top + band * size;
+	for (uint64_t i = 0; i < size; i += 4) {
+		*(volatile uint32_t *)(p + i) = color;
+	}
+	for (uint64_t i = 0; i < size; i += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r"(p + i));
+	}
+	__asm__ volatile ("dsb sy");
+}
+
+void
+miatoll_probe_off(void)
+{
+	miatoll_probe_fb = 0;
+}
+
+void
+miatoll_probe_panic(void)
+{
+	miatoll_probe_bar(13, 0xFFFF0000);
+}
+
 void
 arm_init(
 	boot_args       *args)
@@ -354,15 +401,20 @@ arm_init(
 	DTEntry chosen = NULL;
 	unsigned int dt_entry_size = 0;
 
+	miatoll_probe_start(args);
+	miatoll_probe_bar(2, 0xFFFFFFFF);
+
 	arm_setup_pre_sign();
 
 	arm_slide_rebase_and_sign_image();
+	miatoll_probe_bar(3, 0xFF00FFFF);
 
 	/* If kernel integrity is supported, use a constant copy of the boot args. */
 	const_boot_args = *args;
 	BootArgs = args = &const_boot_args;
 
 	cpu_data_init(&BootCpuData);
+	miatoll_probe_bar(4, 0xFFFFFFFF);
 #if defined(HAS_APPLE_PAC)
 	/* bootstrap cpu process dependent key for kernel has been loaded by start.s */
 	BootCpuData.rop_key = ml_default_rop_pid();
@@ -370,6 +422,7 @@ arm_init(
 #endif /* defined(HAS_APPLE_PAC) */
 
 	PE_init_platform(FALSE, args); /* Get platform expert set up */
+	miatoll_probe_bar(5, 0xFF00FFFF);
 	boot_progress_init();
 
 #if __arm64__
@@ -442,6 +495,7 @@ arm_init(
 #endif
 
 	ml_parse_cpu_topology();
+	miatoll_probe_bar(6, 0xFFFFFFFF);
 
 
 	master_cpu = ml_get_boot_cpu_number();
@@ -471,11 +525,13 @@ arm_init(
 	 */
 	thread->machine.preemption_count = 0;
 	cpu_bootstrap();
+	miatoll_probe_bar(7, 0xFF00FFFF);
 
 	rtclock_early_init();
 
 	kernel_debug_string_early("kernel_startup_bootstrap");
 	kernel_startup_bootstrap();
+	miatoll_probe_bar(8, 0xFFFFFFFF);
 
 	/*
 	 * Initialize the timer callout world
@@ -485,6 +541,7 @@ arm_init(
 	cpu_init();
 
 	processor_bootstrap();
+	miatoll_probe_bar(9, 0xFF00FFFF);
 
 	if (PE_parse_boot_argn("maxmem", &maxmem, sizeof(maxmem))) {
 		xmaxmem = (uint64_t) maxmem * (1024 * 1024);
@@ -532,6 +589,7 @@ arm_init(
 #endif  /* __ARM_PAN_AVAILABLE__ */
 
 	boot_progress_stage("arm_vm_init enter");
+	miatoll_probe_bar(10, 0xFFFFFFFF);
 	arm_vm_init(xmaxmem, args);
 	boot_progress_stage("arm_vm_init returned");
 
